{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "layor",
  "compatibility_date": "2026-09-22",
  "main": "./worker.js",

  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "layor-db",
      "database_id": "607fbaa6-ab34-4e5f-b55e-a80b08737920"
    }
  ],

  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "layor-media"
    }
  ]
}
